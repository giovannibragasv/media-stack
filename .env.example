# ─────────────────────────────────────────────────────────────────────────────
#  Copy this file to .env and fill in the values:  cp .env.example .env
#  .env is gitignored — never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── User / group the containers run as ──────────────────────────────────────
#  These must own ./config and ./data so the apps can read/write.
#  Find yours with:  id -u   (PUID)   and   id -g   (PGID)
#    macOS (Docker Desktop): typically PUID=501  PGID=20
#    Linux:                  typically PUID=1000 PGID=1000
PUID=1000
PGID=1000

# ── Timezone (IANA name) — keeps logs/schedules sane ─────────────────────────
#  Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Belem

# ── Storage roots (host side) ────────────────────────────────────────────────
#  ONE place that controls where everything lives. Defaults work out of the box.
#  When you move to a dedicated server / external HDD, repoint DATA_ROOT here and
#  nothing else changes — the in-container paths (/config, /data) stay fixed, so
#  hardlinks keep working. Keep downloads + libraries on the SAME physical mount.
CONFIG_ROOT=./config      # per-service app state  -> ./config/<service>
DATA_ROOT=./data          # downloads + libraries  -> ./data/{downloads,movies,tv,music}

# ── Host ports (change only if something else already uses them) ─────────────
#  Format is HOST:CONTAINER in compose; these set the HOST side.
QBIT_WEBUI_PORT=8080       # qBittorrent WebUI  -> http://localhost:8080
QBIT_TORRENT_PORT=6881     # BitTorrent listen port (TCP+UDP) — forward this on your router
PROWLARR_PORT=9696         # Prowlarr           -> http://localhost:9696
SONARR_PORT=8989           # Sonarr             -> http://localhost:8989
RADARR_PORT=7878           # Radarr             -> http://localhost:7878
LIDARR_PORT=8686           # Lidarr             -> http://localhost:8686
JELLYFIN_PORT=8096         # Jellyfin           -> http://localhost:8096
FLARESOLVERR_PORT=8191     # FlareSolverr       -> http://localhost:8191

# ── FlareSolverr ─────────────────────────────────────────────────────────────
FLARESOLVERR_LOG_LEVEL=info

# ── Scripts (scripts/import_letterboxd_to_radarr.py) ─────────────────────────
#  Get the key from Radarr ▸ Settings ▸ General ▸ Security ▸ API Key.
#  Used by the Letterboxd importer; NOT read by docker compose.
RADARR_API_KEY=
