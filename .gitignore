# ── Secrets / local environment ──────────────────────────────────────────────
.env
!.env.example

# ── Python ───────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]

# ── macOS cruft ──────────────────────────────────────────────────────────────
.DS_Store

# ── Service config / app data (API keys, DBs, credentials) — NEVER publish ────
config/

# ── Config backups (scripts/backup_config.sh) hold the same secrets ─────────────
backups/

# ── Media & downloads (large, personal) ──────────────────────────────────────
data/

# ── Legacy layout (pre-refactor) — ignore if any of it lingers on disk ────────
downloads/
media/
config-*/
jackett-config/

# ── Personal data used by scripts (watchlist CSV exports, etc.) ───────────────
scripts/watchlists/
*.csv

# ── Internal planning / notes (local working docs, not for GitHub) ────────────
planning/

# ── Backups created during migrations ────────────────────────────────────────
*.bak
*.bak-*
